# NohomeWork — Supabase configuration
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed.

# Your Supabase project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase "anon" (public) key — safe to ship to the browser.
# Find it in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: Never put a SERVICE_ROLE key here. Service-role keys bypass
# Row Level Security and must live only in server-side code / the
# Supabase dashboard. Only VITE_* variables are exposed to the client.